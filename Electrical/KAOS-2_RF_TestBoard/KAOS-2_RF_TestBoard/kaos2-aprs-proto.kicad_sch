	(text "Suggested Pico pins: 1=3V3(OUT), SCK=GP18, MOSI=GP19, MISO=GP16, NSS=GP17,\nNRESET=GP20, DIO0=GP21, DIO2=GP22 (PIO), DIO1=GP26, TCXO_EN=GP27,\nLORA_NSS=GP15, LORA_DIO0=GP13, LORA_RST=GP14, LORA_DIO1=GP12.  GND on 2/4/8/12."
		(exclude_from_sim no)
		(at 20.32 256.54 0)
