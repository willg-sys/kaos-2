	(text "Target PA load ~13.1 + j7.2 ohm (AN1200.19 Table 2).  C0 / C1 / L4 are bench-tuning spots.\nMatch-only build: 0R in L1-L3, C2-C4 not fitted.   Pad: 3 dB = 292R / 17.6R / 292R.\nAll RF caps C0G +-2%;  inductors high-Q wire-wound +-2%, SRF > 450 MHz."
		(exclude_from_sim no)
		(at 150 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
